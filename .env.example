# --- Backend API adresi (ZORUNLU, kodda varsayılan yok) ---
# Tarayıcıdan giden çağrılar (kayıt, iletişim formu, e-posta doğrulama, şifre sıfırlama).
# NEXT_PUBLIC_* build sırasında gömülür: lokal .env.local, docker --build-arg,
# AWS: GitHub Environment "aws-prod" -> variable NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_URL=https://api.raporin.com

# Sunucu (route handler) -> backend iç adresi (runtime). Boşsa NEXT_PUBLIC_API_URL kullanılır.
# AWS'de Terraform task definition'da: http://gateway:8080 (ECS Service Connect).
API_INTERNAL_URL=

# --- Arama motoru doğrulama kodları ---
# Bu değişkenler tanımlı DEĞİLSE ilgili meta etiketi hiç basılmaz.
# Şablon/sahte bir değer yazmayın; doğrulamayı bozar.
#
# NOT: NEXT_PUBLIC_* değişkenleri build sırasında koda gömülür.
# Hosting panelinde ekledikten sonra yeniden deploy almanız gerekir.

# Google Search Console > Mülk ekle > HTML etiketi yöntemindeki content değeri.
# Tercih edilen yöntem DNS TXT doğrulamasıdır; o durumda bu satır boş kalabilir.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools > Site ekle > HTML Meta Tag (msvalidate.01 değeri)
NEXT_PUBLIC_BING_VERIFICATION=

# Yandex Webmaster doğrulama kodu (Türkiye'de hâlâ kayda değer trafik getiriyor)
NEXT_PUBLIC_YANDEX_VERIFICATION=
